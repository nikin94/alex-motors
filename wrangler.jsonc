{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alex-motors",
  "compatibility_date": "2026-07-06",
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // Only API calls invoke the Worker script; every other request keeps the
  // plain static-asset/SPA behaviour the site had before the contact form.
  // No compatibility_flags: the worker uses only Web APIs (TextEncoder, btoa,
  // crypto, URL, cloudflare:email) — nodejs_compat would just add polyfill
  // surface. Buffer appears solely in the Node-side unit tests.
  "run_worker_first": ["/api/*"],
  // Contact-form delivery via Cloudflare Email Routing on alex-motors.ie.
  // CONTACT_TO below is the ONE place the recipient lives: the binding
  // deliberately has no destination_address lock, so changing the inbox is a
  // one-line edit here. Email Routing still only delivers to addresses
  // verified on the account, and the worker only ever sends to CONTACT_TO —
  // the other verified destination addresses receive nothing. An unverified
  // target rejects the send (the endpoint answers 502 and the form falls
  // back to call/WhatsApp).
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": { "CONTACT_FROM": "contact@alex-motors.ie", "CONTACT_TO": "alx.sol@icloud.com" }
}
