{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alex-motors",
  "compatibility_date": "2026-07-06",
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // Only API calls invoke the Worker script; every other request keeps the
  // plain static-asset/SPA behaviour the site had before the contact form.
  // No compatibility_flags: the worker uses only Web APIs (TextEncoder, btoa,
  // crypto, URL, cloudflare:email) — nodejs_compat would just add polyfill
  // surface. Buffer appears solely in the Node-side unit tests.
  "run_worker_first": ["/api/*"],
  // Contact-form delivery via Cloudflare Email Routing on alex-motors.ie.
  // Enquiries go ONLY to the owner's iCloud inbox (Serhiy's decision) — the
  // other verified destination addresses on the account receive nothing:
  // delivery is keyed on this binding + CONTACT_TO, not on the account list.
  // The destination address must show "Verified" in Email Routing before a
  // deploy with this binding can send; an unverified target rejects the send
  // (the endpoint answers 502 and the form falls back to call/WhatsApp).
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "alx.sol@icloud.com" }],
  "vars": { "CONTACT_FROM": "contact@alex-motors.ie", "CONTACT_TO": "alx.sol@icloud.com" }
}
